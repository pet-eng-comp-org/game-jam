# Copie para .env e preencha. O .env nao entra no git nem na imagem.

# Conexao do Prisma com o MySQL.
DATABASE_URL="mysql://root:senha@localhost:3306/gamejam"

# Assina e valida os tokens de sessao. Qualquer string longa e aleatoria serve;
# trocar este valor invalida todas as sessoes abertas.
JWT_SECRET=

# Porta do servidor. Sem ela, 3333.
PORT=3333

# Daqui para baixo, so o docker-compose.yml de desenvolvimento usa.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamejam
DB_PASSWORD=
PHP_MY_ADMIN_PORT=8080

# E-mail de confirmacao da inscricao (opcional; sem SMTP_HOST, nao envia).
# Gmail: smtp.gmail.com, porta 465, senha de app da conta.
SMTP_HOST=
SMTP_PORTA=465
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
