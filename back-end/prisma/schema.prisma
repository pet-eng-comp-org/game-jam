// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// A URL do banco fica em prisma.config.ts (Prisma 7).
datasource db {
  provider = "mysql"
}

model User {

  id String @id @default(uuid())
  // @unique: o login busca o usuario por este campo. Sem a restricao, dois
  // registros com o mesmo nome eram aceitos e o findFirst devolvia sempre o
  // primeiro — o segundo dono do nome nunca mais conseguia entrar, e a causa
  // nao aparecia em lugar nenhum.
  username String @unique
  senha String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("users")
}

model Season {

  id String @id @default(uuid())
  numero String
  capa String
  numParticipantesPorEquipe String
  atual Boolean @default(false)

  // Dados da edicao, editados pelo painel (antes ficavam no codigo do site).
  dataEvento  DateTime? // dia e hora do inicio da competicao
  local       String?   // onde acontece ("CT 9 da Ufes")
  linguagens  String?   // uma por linha
  regulamento String?   @db.Text // markdown

  // Contexto das edicoes antigas, mostrado em /jogos: ano e tema da edicao.
  ano  String? @db.VarChar(4)
  tema String?

  // As inscricoes ficam abertas entre as duas datas. Antes era um liga/desliga
  // manual, que ficou ligado por esquecimento de uma edicao para a outra.
  inscricoesAbrem  DateTime?
  inscricoesFecham DateTime?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("seasons")
  jogos Jogo[]
  equipes Equipe[]
}

model Jogo {

  id String @id @default(uuid())
  // Opcional: de alguns jogos antigos so se sabe a equipe.
  nome String?
  equipe String @default("")
  integrantes String? @db.Text // um por linha
  // Nome de arquivo enviado pelo painel (servido em /files) ou caminho de uma
  // capa do proprio site ("/jogos/x.jpg").
  capa String
  descricao String @db.Text
  link String
  ordem Int @default(0) // ordem dentro da season
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  season Season @relation(fields: [seasonId], references: [id])

  @@map("jogos")
  seasonId String
}

model Equipe {

  id String @id @default(uuid())
  nome String
  aprovada Boolean @default(false)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  season Season @relation(fields: [seasonId], references: [id])

  @@map("equipes")
  seasonId String
  participantes Participante[]
}

model Participante {

  id String @id @default(uuid())
  nome String
  email String
  genero String
  ufes Boolean
  // Sem uso desde 19/10/2026 e sempre vazia: sai na migracao seguinte, quando a
  // imagem anterior da API (que ainda grava cpf) nao for mais volta possivel.
  cpf String?
  curso String?
  instituicao String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  equipe Equipe @relation(fields: [equipeId], references: [id])
  equipeId String

  @@map("participantes")
}

model Material {

  id String @id @default(uuid())
  nome String
  link String
  descricao String
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("materiais")
}

model Regra {

  id String @id @default(uuid())
  tipo String
  conteudo String
  imagem String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("regras")
}

model Patrocinador {

  id String @id @default(uuid())
  nome String
  logo String
  // Site da empresa: a logo no site publico leva ate ele. Opcional.
  site String?
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now())

  @@map("patrocinadores")
}